Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: SAI Library MCP Plugin
Bundle-SymbolicName: com.mcp.sailibrary.plugin;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Activator: com.mcp.sailibrary.plugin.Activator
Bundle-Vendor: SaiLibraryMCPPlugin
Require-Bundle: org.eclipse.ui,
 org.eclipse.ui.ide,
 org.eclipse.ui.navigator,
 org.eclipse.core.runtime,
 org.eclipse.jface,
 org.eclipse.jface.text,
 org.eclipse.ui.editors,
 org.eclipse.core.resources,
 org.eclipse.jdt.core,
 org.eclipse.jdt.ui,
 org.eclipse.swt,
 org.eclipse.pde.core;resolution:=optional,
 org.eclipse.pde.ui;resolution:=optional,
 org.eclipse.m2e.core;resolution:=optional,
 org.eclipse.m2e.core.ui;resolution:=optional,
 org.eclipse.m2e.editor;resolution:=optional,
 org.eclipse.m2e.jdt;resolution:=optional,
 org.eclipse.m2e.jdt.ui;resolution:=optional,
 org.eclipse.m2e.maven.runtime;resolution:=optional
Bundle-RequiredExecutionEnvironment: JavaSE-21
Automatic-Module-Name: com.mcp.sailibrary.plugin
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: ., lib/gson-2.14.0.jar, lib/vineflower-1.12.0.jar, lib/org.eclipse.jgit-7.4.jar, lib/slf4j-api-2.0.17.jar, lib/slf4j-simple-2.0.17.jar
